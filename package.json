{
  "name": "physics-ide",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.2"
  },
  "workspaces": [
    "frontend",
    "shared",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run start -w frontend\"",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend && npm run db:migrate:test -w backend",
    "seed": "npm run seed -w backend",
    "check:blocks": "npm run check:blocks -w frontend",
    "test": "npm run test -ws --if-present",
    "lint": "npm run lint -w shared && npm run lint -w backend && npm run lint -w frontend"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.68.0"
  }
}
