# Read by BuildKit for builds using -f infra/Dockerfile (the per-Dockerfile
# ignore rule — a context-root .dockerignore would belong to the repo root,
# and infra/.dockerignore alone would be inert).
.git
.worktrees
.claude
.superpowers
.vercel
.vscode
node_modules
**/node_modules
docs
e2e
infra
frontend/**
!frontend/package.json
# The built SPA rides into the image (single-origin option 1 — the API
# serves it). Build it FIRST: npm run build -w frontend
!frontend/dist
!frontend/dist/**
backend/src/**/*.test.ts
backend/drizzle
**/.env
**/.env.*
