# Port the API listens on.
PORT=4000
# Postgres connection string.
DATABASE_URL=postgres://postgres:physics@localhost:5433/physics_ide
# development | test | production. Production requires TICK_SECRET,
# MAIL_DRIVER=brevo and MAIL_WEBHOOK_SECRET (see below), and makes the
# session cookie carry Secure.
NODE_ENV=development
# Origin the app is served from — used to build links (invite/join/confirm
# URLs) in outbound mail.
APP_BASE_URL=http://127.0.0.1:3000
# Shared secret POST /api/tick must present. Required in production; a fixed
# dev default is used otherwise (nothing else guards that endpoint there).
# TICK_SECRET=
# Email for the admin console's seeded account (backend/src/seed.ts).
# Defaults to admin@physics-ide.local if left unset.
# ADMIN_EMAIL=
# Display name for the same seeded account. Defaults to "Site Admin" if left unset.
# ADMIN_NAME=
# Password for the admin console's seeded account (backend/src/seed.ts).
# Dev: falls back to a dev-only default with a warning. Production: the seed
# ABORTS at the top without it (Task 6) — set it before any production seed.
# ADMIN_PASSWORD=
# dev | brevo. Which Mailer implementation backs app.mailer. Required to be
# "brevo" in production; defaults to the pretend inbox otherwise.
MAIL_DRIVER=dev
# From address for outbound mail. Required only when MAIL_DRIVER=brevo.
# MAIL_FROM=
# Brevo API key. Required only when MAIL_DRIVER=brevo.
# BREVO_API_KEY=
# Shared secret the Brevo delivery webhook must present. Required in
# production regardless of MAIL_DRIVER; a fixed dev default is used
# otherwise.
# MAIL_WEBHOOK_SECRET=
# true | false | a hop count 1-99. Whether/how Fastify trusts X-Forwarded-*.
# Leave false in local dev. IN PRODUCTION USE A HOP COUNT, NEVER "true":
# "true" trusts every hop and reads the LEFTMOST X-Forwarded-For value —
# which the CLIENT controls on a directly-reachable service, defeating
# every per-IP rate limit. Cloud Run appends the real client IP, so
# TRUST_PROXY=1 reads the rightmost, unspoofable value (DEPLOY-GCP.md
# step 8; behind an extra proxy layer, count the hops).
TRUST_PROXY=false
# Directory of a built SPA for this API to serve from its own origin
# (single-origin deployment — DEPLOY-GCP.md option 1). The container image
# bakes it; leave unset in local dev for the plain API.
# STATIC_DIR=
