# Port the API listens on.
PORT=4000
# Postgres connection string.
DATABASE_URL=postgres://postgres:physics@localhost:5433/physics_ide
# development | test | production. Production requires TICK_SECRET,
# MAIL_DRIVER=brevo and MAIL_WEBHOOK_SECRET (see below), and makes the
# session cookie carry Secure.
NODE_ENV=development
# Origin the app is served from — used to build links (invite/join/confirm
# URLs) in outbound mail.
APP_BASE_URL=http://127.0.0.1:3000
# Shared secret POST /api/tick must present. Required in production; a fixed
# dev default is used otherwise (nothing else guards that endpoint there).
TICK_SECRET=
# Password for the admin console's seeded account. Only enforced (mandatory,
# no dev default) at seed time in production.
ADMIN_PASSWORD=
# dev | brevo. Which Mailer implementation backs app.mailer. Required to be
# "brevo" in production; defaults to the pretend inbox otherwise.
MAIL_DRIVER=dev
# From address for outbound mail. Required only when MAIL_DRIVER=brevo.
MAIL_FROM=
# Brevo API key. Required only when MAIL_DRIVER=brevo.
BREVO_API_KEY=
# Shared secret the Brevo delivery webhook must present. Required in
# production regardless of MAIL_DRIVER; a fixed dev default is used
# otherwise.
MAIL_WEBHOOK_SECRET=
# true | false. Whether Fastify trusts X-Forwarded-* from the reverse proxy
# in front of it. Leave false unless a proxy/load balancer sits in front of
# this instance.
TRUST_PROXY=false
