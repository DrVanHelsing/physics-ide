{
  "name": "@physics-ide/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env HOST=127.0.0.1 tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "cross-env DATABASE_URL=postgres://postgres:physics@localhost:5433/physics_ide_test drizzle-kit migrate",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.1.3",
    "@physics-ide/shared": "*",
    "argon2": "^0.45.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
